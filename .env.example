# Canonical public URL used for metadata, sitemap and robots directives.
PUBLIC_SITE_URL=https://hyperboards.com

# Private endpoint that will receive validated inquiry JSON.
INQUIRY_WEBHOOK_URL=

# Optional server-side bearer token for the webhook. Never expose this as PUBLIC_*.
INQUIRY_WEBHOOK_TOKEN=

# Set to true only after the public domain and all claims have been approved.
PUBLIC_INDEX_SITE=false
