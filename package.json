    "sync:showcase": "node scripts/sync-premium-showcase.mjs",
    "qa:showcase": "node scripts/premium-showcase-qa.mjs",
    "capture:showcase": "node scripts/capture-showcase.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.4",
    "@fontsource-variable/instrument-sans": "^5.3.0",
