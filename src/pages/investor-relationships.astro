---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import FolioLabel from '../components/folios/FolioLabel.astro';
import AlignmentLedger from '../components/folios/AlignmentLedger.astro';
---

<BaseLayout
  title="Investor Relationships | Hyperboards"
  description="Hyperboards selectively develops relationships with aligned investors for direct private-business acquisitions."
  noindex={true}
>
  <main class="alignment">
    <section class="alignment__cover">
      <div class="alignment__cover-grid container-wide">
        <header>
          <FolioLabel index="IR" label="Investor relationships" note="Private relationship context" />
          <h1>Alignment before participation.</h1>
          <p>
            Hyperboards is the direct prospective buyer. For selected acquisitions, we may work with investment partners who share a disciplined, relationship-led approach.
          </p>
          <p class="alignment__quiet">This is a secondary, intentionally discreet part of our work.</p>
        </header>
        <AlignmentLedger />
      </div>
    </section>

    <section class="alignment__context section section--paper">
      <div class="alignment__context-grid container-wide">
        <div>
          <p class="eyebrow">Acquisition context</p>
          <h2>A defined operating mandate.</h2>
        </div>
        <div class="alignment__ranges" aria-label="Acquisition range">
          <div><span>Target EBITDA</span><strong>$750K–$2M</strong></div>
          <div><span>Typical deal value</span><strong>$2M–$6M</strong></div>
        </div>
        <div class="alignment__copy">
          <p>
            These ranges describe our acquisition focus. They are target guidelines—not an offer, allocation, financing commitment or assurance that a transaction will proceed.
          </p>
          <ButtonLink href="/what-we-acquire" variant="quiet">Review the acquisition profile</ButtonLink>
        </div>
      </div>
    </section>

    <section class="alignment__notice section section--compact">
      <div class="alignment__notice-card container">
        <span class="alignment__notice-mark" aria-hidden="true">§</span>
        <div>
          <p class="eyebrow">Important notice</p>
          <h2>This page is not an investment offering.</h2>
          <p>
            Nothing on this website constitutes investment advice, an offer to sell or a solicitation of an offer to buy any security. Any potential participation would be subject to eligibility, separate diligence, formal documentation and applicable law.
          </p>
        </div>
      </div>
    </section>

    <section class="alignment__introduction section section--navy">
      <div class="alignment__introduction-grid container-wide">
        <div>
          <p class="eyebrow">Private introductions</p>
          <h2>Begin with context, not a commitment.</h2>
        </div>
        <div>
          <p>Introduce your investment background and the types of private-company opportunities you consider.</p>
          <ButtonLink href="/contact" variant="light">Introduce yourself</ButtonLink>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .alignment__cover {
    position: relative;
    padding: clamp(5rem, 9vw, 9rem) 0;
    overflow: hidden;
    background-color: #081731;
    background-image: var(--texture-leather);
    background-blend-mode: screen, normal, soft-light;
  }

  .alignment__cover::after {
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: rgba(199, 168, 91, 0.46);
    content: '';
  }

  .alignment__cover-grid {
    display: grid;
    gap: clamp(3rem, 6vw, 7rem);
    align-items: center;
  }

  .alignment__cover header {
    min-width: 0;
    color: rgba(251, 250, 246, 0.7);
  }

  .alignment h1 {
    max-width: 10ch;
    margin-block: 2.5rem 1.5rem;
    color: var(--color-white);
    font-size: clamp(3.2rem, 6.5vw, 7.3rem);
    letter-spacing: -0.055em;
    line-height: 0.91;
  }

  .alignment__cover header > p:not(.alignment__quiet) {
    max-width: 38rem;
    color: rgba(251, 250, 246, 0.7);
    font-size: var(--step-1);
    line-height: 1.65;
  }

  .alignment__quiet {
    margin-top: 2rem;
    padding-left: 1rem;
    border-left: 1px solid rgba(199, 168, 91, 0.64);
    color: rgba(251, 250, 246, 0.46);
    font-size: 0.78rem;
  }

  .alignment__context-grid,
  .alignment__introduction-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .alignment__context h2,
  .alignment__introduction h2 {
    max-width: 11ch;
  }

  .alignment__ranges {
    display: grid;
    border-top: 1px solid rgba(11, 27, 54, 0.16);
  }

  .alignment__ranges > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1.2rem 0;
    border-bottom: 1px solid rgba(11, 27, 54, 0.16);
  }

  .alignment__ranges span {
    color: var(--color-slate);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .alignment__ranges strong {
    color: var(--color-midnight);
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.8rem);
    font-weight: 500;
  }

  .alignment__copy {
    color: var(--color-slate);
  }

  .alignment__copy .button,
  .alignment__introduction .button {
    margin-top: 1.5rem;
  }

  .alignment__notice {
    background: #ebe6dc;
  }

  .alignment__notice-card {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid rgba(11, 27, 54, 0.18);
    background-color: rgba(251, 250, 246, 0.62);
    background-image: var(--texture-paper);
    box-shadow: var(--paper-tile-shadow);
  }

  .alignment__notice-mark {
    color: var(--color-brass-dark);
    font-family: var(--font-serif);
    font-size: 4.5rem;
    line-height: 0.8;
  }

  .alignment__notice h2 {
    max-width: 17ch;
    font-size: clamp(2.2rem, 4vw, 4rem);
  }

  .alignment__notice p:last-child {
    max-width: 52rem;
    color: var(--color-slate);
  }

  .alignment__introduction-grid > div:last-child {
    max-width: 38rem;
  }

  @media (min-width: 82rem) {
    .alignment__cover-grid {
      grid-template-columns: minmax(25rem, 0.7fr) minmax(46rem, 1.3fr);
    }
  }

  @media (min-width: 64rem) {
    .alignment__context-grid {
      grid-template-columns: minmax(17rem, 0.7fr) minmax(20rem, 0.65fr) minmax(20rem, 0.65fr);
    }

    .alignment__introduction-grid {
      grid-template-columns: minmax(0, 1fr) minmax(28rem, 0.7fr);
    }
  }

  @media (min-width: 38rem) {
    .alignment__notice-card {
      grid-template-columns: auto 1fr;
    }
  }

  @media (max-width: 40rem) {
    .alignment h1 {
      font-size: clamp(3rem, 15vw, 4.9rem);
    }
  }
</style>
