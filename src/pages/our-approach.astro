---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import CtaBand from '../components/CtaBand.astro';
import FolioShell from '../components/folios/FolioShell.astro';
import UnderwritingLens from '../components/folios/UnderwritingLens.astro';

const principles = [
  ['01', 'Listen before proposing', 'We first seek to understand the company, the owner’s priorities and what a responsible transition requires.'],
  ['02', 'Underwrite with discipline', 'Interest must be supported by financial, commercial, operational and legal diligence.'],
  ['03', 'Structure with context', 'Price, timing and transition terms should reflect the circumstances of the specific opportunity.'],
  ['04', 'Protect continuity', 'Employees, customers, operating knowledge and critical relationships matter throughout a handover.'],
  ['05', 'Communicate clearly', 'We aim to raise important questions early and keep expectations understandable at every stage.'],
] as const;
---

<BaseLayout
  title="Our Acquisition Approach | Hyperboards"
  description="Learn how Hyperboards acts as a direct buyer, evaluating businesses and working with owners from introduction through transition."
>
  <FolioShell
    eyebrow="Our approach"
    index="03"
    title="Judgment before transaction."
    intro="We evaluate every business directly, looking beyond reported figures to understand the company, the owner’s objectives and the conditions for a responsible transition."
  >
    <div slot="visual">
      <UnderwritingLens />
    </div>
    <div slot="actions">
      <ButtonLink href="/contact">Discuss a potential sale</ButtonLink>
      <ButtonLink href="#buyer-role" variant="light">Understand our role</ButtonLink>
    </div>
  </FolioShell>

  <section class="buyer-role section section--paper" id="buyer-role">
    <div class="buyer-role__layout container-wide">
      <div class="buyer-role__inscription" data-reveal>
        <span>Direct acquisition / principal statement</span>
        <h2>We are the buyer. We do not represent the seller.</h2>
        <div aria-hidden="true">HB</div>
      </div>
      <div class="buyer-role__copy" data-reveal>
        <p class="lede">
          Hyperboards evaluates, negotiates and—when both parties agree—acquires the business. We do not provide investment-banking, brokerage or sell-side advisory services.
        </p>
        <p>
          We do not market your company to third-party buyers. On selected transactions, aligned capital partners may participate; Hyperboards remains the direct prospective buyer and the accountable relationship for the owner.
        </p>
        <ButtonLink href="/business-owners" variant="secondary">What owners can expect</ButtonLink>
      </div>
    </div>
  </section>

  <section class="field-memos section">
    <div class="field-memos__layout container-wide">
      <header data-reveal>
        <p class="eyebrow">Operating principles</p>
        <h2>Five standards for a considered process.</h2>
        <p>They guide how we learn, evaluate and communicate without replacing business-specific judgment.</p>
      </header>
      <ol class="field-memos__stack">
        {principles.map(([number, title, body]) => (
          <li data-reveal>
            <span>{number}</span>
            <div>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="conditional-note section section--navy">
    <div class="conditional-note__sheet container" data-reveal>
      <div class="conditional-note__symbol" aria-hidden="true">∴</div>
      <div>
        <p class="eyebrow">Important context</p>
        <h2>Every acquisition remains conditional.</h2>
        <p>
          Any indication of interest is subject to satisfactory diligence, required approvals, agreed financing where applicable and definitive legal documentation. Published criteria are guidelines, not offers or commitments.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Speak with the buyer"
    title="See whether the fit is worth exploring."
    body="Start with the broad facts of the business and what you are considering."
    label="Discuss a potential sale"
  />
</BaseLayout>

<style>
  .buyer-role__layout,
  .field-memos__layout {
    display: grid;
    gap: var(--space-xl);
  }

  .buyer-role__inscription {
    position: relative;
    min-height: 25rem;
    display: flex;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid rgba(199, 168, 91, 0.52);
    border-radius: var(--radius-lg);
    background-color: var(--color-midnight);
    background-image: var(--texture-leather);
    background-blend-mode: screen, normal, soft-light;
    color: var(--color-white);
    box-shadow: 0 2rem 5rem rgba(11, 27, 54, 0.17);
  }

  .buyer-role__inscription::after {
    position: absolute;
    inset: 0.62rem;
    border-radius: calc(var(--radius-lg) - 0.3rem);
    background: var(--stitch-frame-panel);
    box-shadow: var(--stitch-channel-shadow);
    content: '';
    opacity: 0.88;
    pointer-events: none;
  }

  .buyer-role__inscription > * {
    position: relative;
    z-index: 1;
  }

  .buyer-role__inscription > span {
    color: var(--color-brass-light);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .buyer-role__inscription h2 {
    max-width: 10ch;
    margin: auto 0;
    color: var(--color-white);
    font-size: var(--step-4);
  }

  .buyer-role__inscription > div {
    align-self: end;
    color: var(--color-brass);
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .buyer-role__copy {
    align-self: center;
    max-width: 45rem;
  }

  .buyer-role__copy > p + p {
    margin-top: var(--space-md);
  }

  .buyer-role__copy .button {
    margin-top: var(--space-lg);
  }

  .field-memos {
    background-color: var(--color-paper);
    background-image: var(--texture-paper);
  }

  .field-memos header {
    align-self: start;
  }

  .field-memos header h2 {
    max-width: 12ch;
  }

  .field-memos header > p:last-child {
    max-width: 38rem;
    margin-top: var(--space-md);
    color: var(--color-slate);
  }

  .field-memos__stack {
    padding: 0;
    border-top: 1px solid var(--color-border);
    margin: 0;
    counter-reset: memo;
    list-style: none;
  }

  .field-memos__stack li {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-md);
    padding: clamp(1.25rem, 3vw, 2rem) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .field-memos__stack li::after {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 28%;
    height: 1px;
    background: var(--color-brass);
    content: '';
    opacity: 0;
    transform: scaleX(0);
    transform-origin: right;
    transition: opacity 220ms var(--ease-out), transform 260ms var(--ease-out);
  }

  .field-memos__stack li:hover::after,
  .field-memos__stack li:focus-within::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .field-memos__stack span {
    color: var(--color-brass-dark);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .field-memos__stack h3 {
    margin-bottom: 0.45rem;
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 720;
    letter-spacing: -0.025em;
  }

  .field-memos__stack p {
    max-width: 42rem;
    color: var(--color-slate);
  }

  .conditional-note__sheet {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
    padding: clamp(1.5rem, 4vw, 3.2rem);
    border: 1px solid rgba(199, 168, 91, 0.46);
    background: rgba(7, 20, 42, 0.42);
    box-shadow: var(--deboss-shadow);
  }

  .conditional-note__symbol {
    color: var(--color-brass);
    font-family: var(--font-display);
    font-size: var(--step-5);
    line-height: 0.75;
  }

  .conditional-note h2 {
    max-width: 14ch;
    font-size: var(--step-3);
  }

  .conditional-note p:last-child {
    max-width: 54rem;
  }

  @media (min-width: 64rem) {
    .buyer-role__layout,
    .field-memos__layout {
      grid-template-columns: minmax(20rem, 0.8fr) minmax(32rem, 1.2fr);
    }

    .field-memos header {
      position: sticky;
      top: 8rem;
    }

    .conditional-note__sheet {
      grid-template-columns: auto 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-memos__stack li::after {
      transition: none;
    }
  }
</style>
