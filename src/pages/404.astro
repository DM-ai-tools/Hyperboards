---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Hyperboards"
  description="The requested Hyperboards page could not be found."
  noindex={true}
>
  <main class="missing-route">
    <section class="missing-route__case">
      <article class="route-card" data-route-index>
        <header>
          <span>Hyperboards / Route index</span>
          <span>404</span>
        </header>
        <div class="route-card__message">
          <p class="eyebrow">Index card not found</p>
          <h1>This page is not in the case.</h1>
          <p>The address may have changed or the link may be incomplete. Choose a working route below.</p>
        </div>
        <nav aria-label="Helpful pages">
          <a href="/" data-recovery-link>
            <span>01</span><strong>Home</strong><small>Return to the overview</small><i aria-hidden="true">→</i>
          </a>
          <a href="/what-we-acquire" data-recovery-link>
            <span>02</span><strong>What we acquire</strong><small>Review the acquisition profile</small><i aria-hidden="true">→</i>
          </a>
          <a href="/business-owners" data-recovery-link>
            <span>03</span><strong>For business owners</strong><small>Understand the owner journey</small><i aria-hidden="true">→</i>
          </a>
        </nav>
        <footer><span>HB / Missing reference</span><a href="/contact">Start a confidential conversation</a></footer>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .missing-route {
    display: grid;
    min-height: 82vh;
    place-items: center;
    padding: clamp(1.5rem, 5vw, 5rem);
    overflow: hidden;
    background-color: var(--color-midnight);
    background-image: var(--texture-leather);
    background-blend-mode: screen, normal, soft-light;
  }

  .missing-route__case {
    position: relative;
    width: min(70rem, 100%);
    padding: clamp(1rem, 3vw, 2.2rem);
    border: 1px solid rgba(199, 168, 91, 0.48);
    box-shadow: var(--leather-depth);
  }

  .missing-route__case::before {
    position: absolute;
    inset: 0.55rem;
    background: var(--stitch-frame-panel);
    box-shadow: var(--stitch-channel-shadow);
    content: '';
    pointer-events: none;
  }

  .route-card {
    position: relative;
    z-index: 1;
    padding: clamp(1.5rem, 5vw, 4.5rem);
    background-color: #f0ece2;
    background-image:
      linear-gradient(rgba(11, 27, 54, 0.055) 1px, transparent 1px),
      var(--texture-paper);
    background-size: 100% 2.25rem, auto;
    box-shadow: 0 2.5rem 6rem rgba(0, 0, 0, 0.34), inset 0 0 0 1px rgba(255, 255, 255, 0.7);
    transform: rotate(-0.35deg);
  }

  .route-card::after {
    position: absolute;
    top: -0.8rem;
    left: 50%;
    width: 7rem;
    height: 2rem;
    background: rgba(214, 203, 176, 0.78);
    box-shadow: 0 2px 5px rgba(11, 27, 54, 0.16);
    content: '';
    transform: translateX(-50%) rotate(1.5deg);
  }

  .route-card > header,
  .route-card > footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-slate);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .route-card > header { padding-bottom: 1rem; border-bottom: 2px solid var(--color-midnight); }
  .route-card__message { padding-block: clamp(2.5rem, 6vw, 5rem); }
  .route-card h1 { max-width: 11ch; margin-block: 1rem; font-size: clamp(3rem, 7vw, 6.6rem); line-height: 0.91; }
  .route-card__message > p:last-child { max-width: 40rem; color: var(--color-slate); }

  .route-card nav { display: grid; border-top: 1px solid rgba(11, 27, 54, 0.16); }

  .route-card nav a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    gap: 0.15rem 1rem;
    align-items: center;
    min-height: 5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(11, 27, 54, 0.16);
    color: var(--color-midnight);
    text-decoration: none;
  }

  .route-card nav a > span { grid-row: 1 / 3; color: var(--color-brass-dark); font-family: var(--font-mono); font-size: 0.62rem; }
  .route-card nav strong { font-family: var(--font-serif); font-size: clamp(1.25rem, 2.4vw, 1.9rem); font-weight: 500; }
  .route-card nav small { color: var(--color-slate); }
  .route-card nav i { grid-row: 1 / 3; grid-column: 3; font-style: normal; transition: transform 180ms var(--ease-out); }
  .route-card nav a:hover i, .route-card nav a:focus-visible i { transform: translateX(0.35rem); }

  .route-card > footer { align-items: center; padding-top: 1.2rem; }
  .route-card > footer a { color: var(--color-forest); }

  @media (max-width: 35rem) {
    .route-card { transform: none; }
    .route-card h1 { font-size: clamp(3rem, 14vw, 4.5rem); }
    .route-card nav small { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-card nav i { transition: none; }
  }
</style>
