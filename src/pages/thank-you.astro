---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
---

<BaseLayout
  title="Thank You | Hyperboards"
  description="Thank you for contacting Hyperboards."
  noindex={true}
>
  <main class="receipt-page">
    <section class="receipt-page__stage">
      <article class="receipt" data-review-receipt>
        <header>
          <div class="receipt__brand"><span>H</span><strong>Hyperboards</strong></div>
          <span class="receipt__status">Introduction accepted</span>
        </header>

        <div class="receipt__confirmation">
          <p class="eyebrow">Private acquisition inquiry</p>
          <h1>Thank you for reaching out.</h1>
          <p>
            If you arrived here after submitting the inquiry form, your introduction was accepted. The next step is a considered review, not an automated sales sequence.
          </p>
        </div>

        <div class="receipt__rule"><span>Review record</span><span>HB / INTAKE</span></div>

        <section class="receipt__next" aria-labelledby="next-title">
          <div>
            <p class="eyebrow">What happens next</p>
            <h2 id="next-title">A private first review.</h2>
          </div>
          <ol>
            <li data-review-step>
              <span>01</span>
              <div><h3>Broad fit is considered</h3><p>The information submitted is reviewed against the acquisition profile.</p></div>
            </li>
            <li data-review-step>
              <span>02</span>
              <div><h3>An appropriate response follows</h3><p>If a next conversation appears useful, the contact details provided will be used to respond.</p></div>
            </li>
            <li data-review-step>
              <span>03</span>
              <div><h3>Sensitive detail waits</h3><p>Please do not send confidential records until protections and a secure sharing method are agreed.</p></div>
            </li>
          </ol>
        </section>

        <footer>
          <p>No transaction interest, offer or timing commitment is implied by this acknowledgement.</p>
          <ButtonLink href="/what-we-acquire" variant="quiet">Review what we acquire</ButtonLink>
        </footer>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .receipt-page {
    min-height: 80vh;
    padding: clamp(2rem, 6vw, 6rem) 0;
    overflow: hidden;
    background-color: var(--color-midnight);
    background-image: var(--texture-leather);
    background-blend-mode: screen, normal, soft-light;
  }

  .receipt-page__stage {
    position: relative;
    width: min(72rem, calc(100% - 2rem));
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 2.5rem);
    border: 1px solid rgba(199, 168, 91, 0.45);
  }

  .receipt-page__stage::before {
    position: absolute;
    inset: 0.6rem;
    background: var(--stitch-frame-panel);
    box-shadow: var(--stitch-channel-shadow);
    content: '';
    pointer-events: none;
  }

  .receipt {
    position: relative;
    z-index: 1;
    padding: clamp(1.5rem, 5vw, 4.5rem);
    background-color: #f0ece3;
    background-image: var(--texture-paper);
    box-shadow: 0 2.5rem 6rem rgba(0, 0, 0, 0.34), inset 0 0 0 1px rgba(255, 255, 255, 0.7);
  }

  .receipt > header,
  .receipt > footer,
  .receipt__rule {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .receipt > header {
    padding-bottom: 1.2rem;
    border-bottom: 2px solid var(--color-midnight);
  }

  .receipt__brand { display: flex; gap: 0.7rem; align-items: center; }
  .receipt__brand > span { display: grid; width: 2rem; aspect-ratio: 1; place-items: center; border: 1px solid var(--color-brass-dark); color: var(--color-brass-dark); font-family: var(--font-serif); }
  .receipt__brand strong { font-family: var(--font-serif); font-weight: 600; }
  .receipt__status { padding: 0.55rem 0.75rem; border: 1px solid rgba(39, 72, 61, 0.45); color: var(--color-forest); font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; }

  .receipt__confirmation {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .receipt h1 {
    max-width: 12ch;
    margin-block: 1.2rem;
    font-size: clamp(3rem, 7vw, 6.8rem);
    line-height: 0.91;
  }

  .receipt__confirmation > p:last-child { max-width: 43rem; color: var(--color-slate); font-size: var(--step-1); }
  .receipt__rule { padding-block: 0.85rem; border-block: 1px solid rgba(11, 27, 54, 0.15); color: var(--color-slate); font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase; }

  .receipt__next {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .receipt__next h2 { max-width: 10ch; font-size: clamp(2.4rem, 5vw, 4.6rem); }
  .receipt__next ol { padding: 0; margin: 0; list-style: none; }
  .receipt__next li { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; padding: 1.2rem 0; border-bottom: 1px solid rgba(11, 27, 54, 0.14); }
  .receipt__next li > span { color: var(--color-brass-dark); font-family: var(--font-mono); font-size: 0.65rem; }
  .receipt__next h3 { margin-bottom: 0.3rem; font-family: var(--font-sans); font-size: 1rem; }
  .receipt__next li p { color: var(--color-slate); font-size: 0.82rem; }

  .receipt > footer { padding-top: 1.4rem; border-top: 2px solid var(--color-midnight); }
  .receipt > footer p { max-width: 34rem; margin: 0; color: var(--color-slate); font-size: 0.72rem; }

  @media (min-width: 52rem) {
    .receipt__next { grid-template-columns: minmax(16rem, 0.65fr) minmax(28rem, 1.35fr); }
  }

  @media (max-width: 36rem) {
    .receipt h1 { font-size: clamp(3rem, 14vw, 4.5rem); }
  }
</style>
