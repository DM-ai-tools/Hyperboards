---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import CtaBand from '../components/CtaBand.astro';
import FolioShell from '../components/folios/FolioShell.astro';
import OwnerPathSelector from '../components/folios/OwnerPathSelector.astro';

const ownerNotes = [
  ['01', 'Planning succession', 'Retirement may be approaching, or the next generation may be taking a different path.'],
  ['02', 'Starting a new chapter', 'You may be ready to redirect your time, energy or entrepreneurial attention.'],
  ['03', 'Reducing responsibility', 'You may want to reduce personal concentration or day-to-day operating demands.'],
  ['04', 'Preparing for growth', 'The company’s next stage may benefit from a new ownership structure.'],
] as const;
---

<BaseLayout
  title="For Business Owners | Hyperboards"
  description="Speak directly with Hyperboards as a prospective buyer about selling your established business."
>
  <FolioShell
    eyebrow="For business owners"
    index="02"
    title="Your transition, considered privately."
    intro="You can explore timing and broad fit directly with the prospective buyer—without appointing a broker, launching an auction or committing to a sale."
  >
    <div slot="visual">
      <OwnerPathSelector />
    </div>
    <div slot="actions">
      <ButtonLink href="/contact">Begin a confidential conversation</ButtonLink>
      <ButtonLink href="/what-we-acquire" variant="light">Review our criteria</ButtonLink>
    </div>
  </FolioShell>

  <section class="owner-letter section section--paper">
    <div class="owner-letter__layout container-wide">
      <div class="owner-letter__title" data-reveal>
        <p class="eyebrow">A private first step</p>
        <h2>A conversation before a process.</h2>
        <div class="owner-letter__signature" aria-hidden="true">H</div>
      </div>
      <div class="owner-letter__body" data-reveal>
        <p class="lede">
          Hyperboards begins with what matters to you, how the company works and whether there is enough alignment to keep talking.
        </p>
        <p>
          An introduction does not oblige either party to continue. We do not require a complete sale package at the outset, and we do not use the conversation as a mandate to represent you.
        </p>
        <p class="owner-letter__postscript">
          Broad facts are enough for the first exchange. Sensitive operating detail belongs later, under appropriate protections.
        </p>
      </div>
    </div>
  </section>

  <section class="owner-notes section">
    <div class="owner-notes__layout container-wide">
      <header data-reveal>
        <p class="eyebrow">Why owners reach out</p>
        <h2>There is no single reason to consider what comes next.</h2>
        <p>You do not need a final decision or a public listing to learn whether Hyperboards may be a suitable buyer.</p>
      </header>
      <ol class="owner-notes__list">
        {ownerNotes.map(([number, title, body]) => (
          <li data-reveal>
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="confidential-note section section--compact section--navy">
    <div class="confidential-note__paper container" data-reveal>
      <div class="confidential-note__seal" aria-hidden="true">Private</div>
      <div>
        <p class="eyebrow">A note on confidentiality</p>
        <h2>Share enough to establish fit—not every sensitive detail.</h2>
        <p>
          Please do not send customer lists, employee information, proprietary documents or account credentials through the initial form. Appropriate confidentiality arrangements can be established before detailed diligence.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Speak with the buyer"
    title="Considering selling your business?"
    body="Tell Hyperboards where you are in the process and what a good outcome would look like."
    label="Discuss selling your business"
  />
</BaseLayout>

<style>
  .owner-letter {
    overflow: hidden;
  }

  .owner-letter__layout,
  .owner-notes__layout {
    display: grid;
    gap: var(--space-xl);
  }

  .owner-letter__title {
    position: relative;
    min-height: 22rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid rgba(11, 27, 54, 0.14);
    background: rgba(251, 250, 246, 0.54);
    box-shadow: var(--paper-tile-shadow);
  }

  .owner-letter__title::before {
    position: absolute;
    inset: 0.65rem;
    border: 1px solid rgba(11, 27, 54, 0.1);
    content: '';
    pointer-events: none;
  }

  .owner-letter h2 {
    position: relative;
    max-width: 10ch;
    font-size: var(--step-4);
  }

  .owner-letter__signature {
    position: absolute;
    right: clamp(1.5rem, 4vw, 3rem);
    bottom: clamp(1.5rem, 4vw, 3rem);
    display: grid;
    width: 4.5rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-brass-dark);
    border-radius: 50%;
    color: var(--color-midnight);
    font-family: var(--font-display);
    font-size: var(--step-2);
    transform: rotate(-7deg);
  }

  .owner-letter__body {
    align-self: center;
    max-width: 44rem;
  }

  .owner-letter__body > p + p {
    margin-top: var(--space-md);
  }

  .owner-letter__postscript {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    color: var(--color-slate);
    font-size: var(--step--1);
  }

  .owner-notes header {
    align-self: start;
  }

  .owner-notes header h2 {
    max-width: 13ch;
  }

  .owner-notes header > p:last-child {
    max-width: 38rem;
    margin-top: var(--space-md);
    color: var(--color-slate);
  }

  .owner-notes__list {
    padding: 0;
    border-top: 1px solid var(--color-border);
    margin: 0;
    list-style: none;
  }

  .owner-notes__list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 0.72fr) minmax(0, 1fr);
    gap: var(--space-md);
    align-items: baseline;
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .owner-notes__list span {
    color: var(--color-brass-dark);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .owner-notes__list h3 {
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 720;
    letter-spacing: -0.025em;
  }

  .owner-notes__list p {
    color: var(--color-slate);
  }

  .confidential-note__paper {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid rgba(199, 168, 91, 0.55);
    border-radius: var(--radius-lg);
    background-color: var(--color-paper);
    background-image: var(--texture-paper);
    color: var(--color-midnight);
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.2);
  }

  .confidential-note__seal {
    display: grid;
    width: 7.5rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-brass-dark);
    border-radius: 50%;
    color: var(--color-forest);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: rotate(-5deg);
  }

  .confidential-note h2 {
    max-width: 16ch;
    font-size: var(--step-3);
  }

  .confidential-note p:last-child {
    max-width: 51rem;
    color: var(--color-slate);
  }

  @media (min-width: 64rem) {
    .owner-letter__layout,
    .owner-notes__layout {
      grid-template-columns: minmax(20rem, 0.8fr) minmax(32rem, 1.2fr);
    }

    .owner-notes header {
      position: sticky;
      top: 8rem;
    }

    .confidential-note__paper {
      grid-template-columns: auto 1fr;
    }
  }

  @media (max-width: 44rem) {
    .owner-notes__list li {
      grid-template-columns: 2.5rem 1fr;
    }

    .owner-notes__list p {
      grid-column: 2;
    }
  }
</style>
