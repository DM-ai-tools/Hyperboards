---
import DesignCard from '../components/design-gallery/DesignCard.astro';
import DesignGalleryLayout from '../layouts/DesignGalleryLayout.astro';
import { designs } from '../data/designs';
---

<DesignGalleryLayout>
  <div class="gallery-shell">
    <header class="gallery-intro">
      <a class="gallery-brand" href="/" aria-label="Hyperboards design review home">
        <span aria-hidden="true">H</span>
        <strong>Hyperboards</strong>
      </a>
      <div class="gallery-intro__copy">
        <p>Homepage design review</p>
        <h1>Choose a homepage direction.</h1>
      </div>
      <p class="gallery-intro__note">Six finalized approaches. Select any panel to open the complete design.</p>
    </header>

    <main id="gallery-content" class="design-grid">
      {designs.map((design, index) => <DesignCard design={design} index={index} />)}
    </main>

    <footer class="gallery-footer">
      <span>Hyperboards</span>
      <span>Design selection · August 2026</span>
    </footer>
  </div>
</DesignGalleryLayout>

<style>
  .gallery-shell {
    width: min(100% - clamp(1.5rem, 5vw, 5rem), 92rem);
    margin-inline: auto;
    padding-block: clamp(1.2rem, 3vw, 2.4rem) 1.5rem;
  }

  .gallery-intro {
    display: grid;
    grid-template-columns: minmax(10rem, 0.42fr) minmax(18rem, 1fr) minmax(14rem, 0.55fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-bottom: clamp(1.7rem, 4vw, 3.2rem);
    border-bottom: 1px solid var(--gallery-ink);
  }

  .gallery-brand {
    display: inline-flex;
    width: fit-content;
    align-self: start;
    align-items: center;
    gap: 0.58rem;
    text-decoration: none;
  }

  .gallery-brand span {
    display: grid;
    width: 1.55rem;
    aspect-ratio: 1;
    border: 1px solid var(--gallery-green);
    color: var(--gallery-green);
    font-family: var(--gallery-display);
    font-size: 0.86rem;
    place-items: center;
  }

  .gallery-brand strong {
    font-size: 0.78rem;
    letter-spacing: -0.015em;
  }

  .gallery-intro__copy p {
    margin: 0 0 0.65rem;
    color: var(--gallery-green);
    font-size: 0.62rem;
    font-weight: 760;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-family: var(--gallery-display);
    font-size: clamp(2.55rem, 5.7vw, 5.6rem);
    font-weight: 470;
    letter-spacing: -0.052em;
    line-height: 0.88;
  }

  .gallery-intro__note {
    max-width: 26rem;
    margin: 0;
    color: var(--gallery-muted);
    font-size: clamp(0.78rem, 1.2vw, 0.92rem);
    line-height: 1.55;
  }

  .design-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-block: clamp(1.4rem, 3vw, 2.6rem);
  }

  .gallery-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--gallery-rule);
    color: var(--gallery-muted);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 52rem) {
    .gallery-intro {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.5rem;
    }

    .gallery-intro__note {
      max-width: 36rem;
    }
  }

  @media (max-width: 44rem) {
    .design-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
