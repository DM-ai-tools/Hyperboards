---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import CriteriaBand from '../components/CriteriaBand.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import HeroArtwork from '../components/HeroArtwork.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SectionIntro from '../components/SectionIntro.astro';
import SectorGrid from '../components/SectorGrid.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="hero__inner container-wide">
      <div class="hero__copy">
        <p class="eyebrow">Direct business buyer</p>
        <h1>A thoughtful next chapter for the business you built.</h1>
        <p class="hero__lede">
          <strong>We buy established, profitable businesses directly from their owners.</strong> We work discreetly and with respect for the company’s people, customers and legacy.
        </p>
        <div class="cluster hero__actions">
          <ButtonLink href="/contact" variant="primary">Discuss selling your business</ButtonLink>
          <ButtonLink href="/what-we-acquire" variant="light">See what we acquire</ButtonLink>
        </div>
        <p class="hero__note">You do not need to be actively selling to begin a conversation.</p>
      </div>
      <HeroArtwork />
    </div>
  </section>

  <CriteriaBand />

  <section class="section owner-context">
    <div class="container">
      <SectionIntro
        eyebrow="Our role"
        title="We are the buyer—not the adviser finding one."
        intro="Hyperboards evaluates businesses as the potential acquirer. We do not represent sellers, run a sale process or market companies to third-party bidders. You speak directly with the party considering the purchase."
        align="split"
      />
      <div class="owner-context__aside" data-reveal>
        <p class="owner-context__line">Not an investment bank.</p>
        <p class="owner-context__line">Not a broker.</p>
        <p class="owner-context__line">Not an M&A adviser.</p>
        <p class="owner-context__line owner-context__line--accent">Hyperboards is the buyer.</p>
      </div>
    </div>
  </section>

  <section class="section section--paper relationship">
    <div class="container">
      <SectionIntro
        eyebrow="Why Hyperboards"
        title="Work directly with the people seeking to buy your business."
        intro="The relationship remains buyer to owner: clear, appropriately private and centered on the realities of your company."
        align="split"
      />

      <div class="principles">
        <article data-reveal>
          <span>01</span>
          <h3>Direct engagement</h3>
          <p>Hyperboards sits on the buyer’s side of the table. Speak with the people evaluating the purchase—not an intermediary searching for another acquirer.</p>
        </article>
        <article data-reveal>
          <span>02</span>
          <h3>Discretion from the outset</h3>
          <p>Begin with a limited exchange of information and introduce sensitive details only when appropriate protections are in place.</p>
        </article>
        <article data-reveal>
          <span>03</span>
          <h3>Flexible transitions</h3>
          <p>A complete exit, phased handover or continued involvement may be considered around the owner and the business.</p>
        </article>
        <article data-reveal>
          <span>04</span>
          <h3>Respect for what works</h3>
          <p>We look to understand the strengths behind a company before deciding how its next chapter should take shape.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section sectors-section">
    <div class="container-wide">
      <SectionIntro
        eyebrow="Businesses we consider"
        title="Nine sectors, selected for durable demand."
        intro="The sector is only the starting point. We look for repeatable economics, transferable operations and a strong underlying business."
        align="split"
      />
      <SectorGrid />
      <div class="sectors-section__footer" data-reveal>
        <p>Sector inclusion does not imply automatic fit. Every opportunity must independently satisfy our acquisition and underwriting criteria.</p>
        <ButtonLink href="/what-we-acquire" variant="secondary">Explore the full criteria</ButtonLink>
      </div>
    </div>
  </section>

  <section class="section section--navy process-section">
    <div class="container-wide">
      <SectionIntro
        eyebrow="A considered process"
        title="Clear steps, without unnecessary theatre."
        intro="A business should be understood before terms are finalized. Our process builds detail as mutual interest grows."
        align="split"
      />
      <ProcessSteps />
    </div>
  </section>

  <section class="section stewardship">
    <div class="container">
      <div class="stewardship__grid">
        <div data-reveal>
          <p class="eyebrow">After the transaction</p>
          <h2>Stewardship starts with understanding.</h2>
        </div>
        <div class="stewardship__copy" data-reveal>
          <p class="lede">A strong business is more than its financial statements. Its reputation, employees, customer relationships and operating knowledge matter.</p>
          <p>Our approach is designed around understanding these foundations and shaping a responsible transition. We do not begin with a promise to change everything—or a promise that nothing will ever change. We begin by listening.</p>
          <ButtonLink href="/business-owners" variant="secondary">For business owners</ButtonLink>
        </div>
      </div>
      <div class="stewardship__words" aria-hidden="true">
        <svg viewBox="0 0 1760 170" focusable="false">
          <text x="0" y="130">People</text>
          <text x="510" y="130">Customers</text>
          <text x="1160" y="130">Continuity</text>
        </svg>
      </div>
    </div>
  </section>

  <section class="investor-note">
    <div class="investor-note__inner container" data-reveal>
      <p class="eyebrow">Investor relationships</p>
      <div>
        <h2>Aligned capital, kept in context.</h2>
        <p>On select acquisitions, we may work alongside aligned investment partners. These relationships remain transaction-specific and secondary to a clear seller experience.</p>
      </div>
      <a class="text-link" href="/investor-relationships">Read more</a>
    </div>
  </section>

  <section class="section section--paper faq-section">
    <div class="container">
      <SectionIntro
        eyebrow="Common questions"
        title="Begin with clarity."
        intro="A first conversation should answer the practical questions without creating pressure to proceed."
        align="split"
      />
      <FaqList />
    </div>
  </section>

  <CtaBand
    eyebrow="Speak with the buyer"
    title="Considering selling your business?"
    body="Begin with a private, no-obligation conversation directly with Hyperboards."
    label="Discuss selling your business"
  />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-midnight);
    background-image: var(--texture-leather);
    color: rgba(251, 250, 246, 0.72);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 75% 35%, rgba(39, 72, 61, 0.4), transparent 34%);
    content: '';
  }

  .hero__inner {
    position: relative;
    display: grid;
    min-height: min(52rem, calc(100svh - 5.5rem));
    align-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
  }

  .hero h1 {
    max-width: 11ch;
    margin-bottom: var(--space-md);
    color: var(--color-white);
  }

  .hero__lede {
    max-width: 42rem;
    margin-bottom: var(--space-lg);
    color: rgba(251, 250, 246, 0.76);
    font-size: var(--step-1);
  }

  .hero__lede strong {
    color: var(--color-white);
    font-weight: 690;
  }

  .hero__actions {
    margin-bottom: var(--space-md);
  }

  .hero__note {
    color: rgba(251, 250, 246, 0.52);
    font-size: var(--step--1);
  }

  .owner-context {
    position: relative;
  }

  .owner-context__aside {
    position: relative;
    max-width: 57rem;
    margin-left: auto;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    overflow: hidden;
    border: 1px solid rgba(199, 168, 91, 0.52);
    border-radius: var(--radius-lg);
    background-color: var(--color-midnight);
    background-image: var(--texture-leather);
    box-shadow: var(--leather-depth), 0 1.5rem 4rem rgba(11, 27, 54, 0.13);
  }

  .owner-context__aside::before {
    position: absolute;
    inset: 0.62rem;
    border: 0;
    border-radius: calc(var(--radius-lg) - 0.3rem);
    background: var(--stitch-frame-panel);
    box-shadow: var(--stitch-channel-shadow);
    content: '';
    opacity: 0.92;
    pointer-events: none;
  }

  .owner-context__line {
    position: relative;
    margin: 0;
    color: rgba(251, 250, 246, 0.62);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.35;
  }

  .owner-context__line--accent {
    margin-top: 0.35rem;
    color: var(--color-brass-light);
  }

  .principles {
    display: grid;
    gap: var(--space-sm);
  }

  .principles article {
    position: relative;
    padding: var(--space-lg);
    border: 1px solid rgba(11, 27, 54, 0.12);
    border-radius: var(--radius-md);
    background-color: rgba(251, 250, 246, 0.62);
    background-image: var(--texture-paper);
    box-shadow: var(--paper-tile-shadow);
    transition: border-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out), transform 220ms var(--ease-out);
  }

  .principles article:hover {
    border-color: rgba(199, 168, 91, 0.42);
    box-shadow: var(--paper-tile-shadow-hover);
    transform: translateY(-0.18rem);
  }

  .principles span {
    color: var(--color-forest);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .principles h3 {
    margin: var(--space-sm) 0 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 680;
    letter-spacing: -0.025em;
  }

  .principles p {
    color: var(--color-slate);
    font-size: 0.95rem;
  }

  .sectors-section__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-lg);
  }

  .sectors-section__footer p {
    max-width: 43rem;
    color: var(--color-slate);
    font-size: var(--step--1);
  }

  .stewardship {
    overflow: hidden;
  }

  .stewardship__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .stewardship__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
  }

  .stewardship__words {
    width: max(110rem, 145%);
    margin-top: var(--space-2xl);
    color: rgba(11, 27, 54, 0.08);
    transform: translateX(-4vw);
  }

  .stewardship__words svg {
    width: 100%;
    overflow: visible;
  }

  .stewardship__words text {
    fill: currentColor;
    font-family: var(--font-display);
    font-size: 150px;
    letter-spacing: -0.04em;
  }

  .investor-note {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .investor-note__inner {
    display: grid;
    gap: var(--space-md);
    align-items: start;
  }

  .investor-note h2 {
    margin-bottom: 0.7rem;
    font-family: var(--font-sans);
    font-size: var(--step-2);
    font-weight: 680;
    letter-spacing: -0.03em;
  }

  .investor-note p:not(.eyebrow) {
    max-width: 42rem;
    color: var(--color-slate);
  }

  @media (min-width: 48rem) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .principles article:nth-child(odd) {
      padding-right: var(--space-lg);
    }

    .principles article:nth-child(even) {
      padding-left: var(--space-lg);
    }

    .stewardship__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(22rem, 0.9fr);
    }

    .investor-note__inner {
      grid-template-columns: 12rem 1fr auto;
    }
  }

  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(28rem, 0.92fr);
    }
  }

  @media (max-width: 63.99rem) {
    .hero__inner :global(.hero-art) {
      position: absolute;
      right: -16rem;
      bottom: -8rem;
      width: 38rem;
      opacity: 0.32;
    }
  }
</style>
