---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import SectorGrid from '../components/SectorGrid.astro';
import ButtonLink from '../components/ButtonLink.astro';
import CtaBand from '../components/CtaBand.astro';
import { criteria, exclusions } from '../data/site';

const preferredCharacteristics = [
  'Recurring, contracted or repeat customer demand',
  'Defensible customer and supplier relationships',
  'Consistent, understandable earnings',
  'Capable employees and transferable operating processes',
  'Sensible working-capital and capital-expenditure needs',
  'Practical opportunities for continued growth',
];
---

<BaseLayout
  title="What We Acquire | Hyperboards"
  description="See the financial profile, characteristics and industries of businesses Hyperboards may buy directly from their owners."
>
  <PageHero
    eyebrow="What we buy"
    title="Established businesses with durable foundations."
    intro="These are the companies Hyperboards considers buying directly: profitable businesses with repeat demand, transferable operations and meaningful potential for continued growth."
    marker="01"
  />

  <section class="profile section section--paper">
    <div class="container-wide">
      <SectionIntro
        eyebrow="The broad fit"
        title="A focused mandate, considered business by business."
        intro="The figures below define where we concentrate our attention as a buyer. They are guidelines—not an automatic decision or a commitment to transact."
        align="split"
      />

      <dl class="profile__grid" aria-label="Acquisition profile">
        {criteria.map((item) => (
          <div data-reveal>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>

      <p class="profile__note fine-print">
        Typical deal value depends on earnings quality, transaction structure and the valuation supported by the specific business.
      </p>
    </div>
  </section>

  <section class="characteristics section">
    <div class="characteristics__grid container-wide">
      <div class="characteristics__intro" data-reveal>
        <p class="eyebrow">What matters beyond size</p>
        <h2>Quality we can understand. Strength we can preserve.</h2>
        <p class="lede">
          Financial fit starts the conversation. The durability of the company—and how well it can transition—determines whether it should continue.
        </p>
        <ButtonLink href="/our-approach" variant="secondary">How we evaluate a business</ButtonLink>
      </div>

      <ol class="characteristics__list">
        {preferredCharacteristics.map((item, index) => (
          <li data-reveal>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sectors section section--paper">
    <div class="container-wide">
      <SectionIntro
        eyebrow="Target industries"
        title="Nine sectors chosen for durable demand."
        intro="We are interested in sectors where repeat use, established relationships or transferable operating capabilities can support continued performance."
        align="split"
      />
      <SectorGrid />
      <p class="sectors__qualification fine-print" data-reveal>
        Sector inclusion does not imply allocation. Every opportunity must independently satisfy our acquisition and underwriting criteria.
      </p>
    </div>
  </section>

  <section class="exclusions section section--navy">
    <div class="exclusions__grid container-wide">
      <div data-reveal>
        <p class="eyebrow">Current boundaries</p>
        <h2>Outside our present mandate.</h2>
        <p>
          A clear mandate helps us respond candidly and focus our diligence where we have genuine acquisition interest.
        </p>
      </div>
      <ul aria-label="Currently excluded industries">
        {exclusions.map((item) => <li data-reveal>{item}</li>)}
      </ul>
    </div>
  </section>

  <CtaBand
    eyebrow="Sell directly to Hyperboards"
    title="Considering selling a business that fits?"
    body="Speak directly with Hyperboards as the prospective buyer. No formal sale process is required."
    label="Discuss a potential sale"
  />
</BaseLayout>

<style>
  .profile__grid {
    display: grid;
    padding: 0;
    margin: 0;
    gap: var(--space-sm);
  }

  .profile__grid > div {
    display: flex;
    min-height: 9.5rem;
    flex-direction: column-reverse;
    justify-content: space-between;
    padding: var(--space-md);
    border: 1px solid rgba(11, 27, 54, 0.14);
    border-radius: var(--radius-md);
    background-color: rgba(251, 250, 246, 0.68);
    background-image: var(--texture-paper);
    box-shadow: var(--paper-tile-shadow);
  }

  .profile__grid > div:last-child {
    border-bottom: 1px solid rgba(11, 27, 54, 0.14);
  }

  .profile__grid dt {
    color: var(--color-slate);
    font-size: var(--step--1);
  }

  .profile__grid dd {
    margin: 0;
    color: var(--color-midnight);
    font-family: var(--font-display);
    font-size: var(--step-3);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .profile__note {
    max-width: 48rem;
    margin-top: var(--space-md);
  }

  .characteristics__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .characteristics__intro h2 {
    max-width: 12ch;
  }

  .characteristics__intro .button {
    margin-top: var(--space-md);
  }

  .characteristics__list {
    padding: 0;
    border-top: 1px solid var(--color-border);
    margin: 0;
    list-style: none;
  }

  .characteristics__list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-sm);
    align-items: baseline;
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .characteristics__list span {
    color: var(--color-forest);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .characteristics__list p {
    color: var(--color-midnight);
    font-size: var(--step-1);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.35;
  }

  .sectors__qualification {
    max-width: 50rem;
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-brass);
    margin-top: var(--space-lg);
  }

  .exclusions__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .exclusions h2 {
    max-width: 10ch;
  }

  .exclusions__grid > div > p:last-child {
    max-width: 35rem;
  }

  .exclusions ul {
    display: grid;
    padding: 0;
    border-top: 1px solid var(--color-border-dark);
    margin: 0;
    list-style: none;
  }

  .exclusions li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border-dark);
    color: var(--color-white);
  }

  @media (min-width: 42rem) {
    .profile__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .profile__grid > div {
      padding-inline: var(--space-md);
    }

    .profile__grid > div:nth-child(odd) {
      padding-left: var(--space-md);
    }

    .profile__grid > div:nth-child(even) {
      padding-right: var(--space-md);
    }

    .profile__grid > div:nth-last-child(-n + 2) {
      border-bottom: 1px solid rgba(11, 27, 54, 0.14);
    }

    .exclusions ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-lg);
    }
  }

  @media (min-width: 64rem) {
    .profile__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .profile__grid > div,
    .profile__grid > div:nth-child(odd),
    .profile__grid > div:nth-child(even) {
      padding-inline: var(--space-md);
      border: 1px solid rgba(11, 27, 54, 0.14);
    }

    .profile__grid > div:first-child {
      padding-left: var(--space-md);
    }

    .profile__grid > div:last-child {
      padding-right: var(--space-md);
      border-right: 1px solid rgba(11, 27, 54, 0.14);
    }

    .characteristics__grid,
    .exclusions__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(30rem, 1.1fr);
    }

    .characteristics__intro {
      position: sticky;
      top: 8rem;
      align-self: start;
    }
  }
</style>
