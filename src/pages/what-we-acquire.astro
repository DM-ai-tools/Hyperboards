---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import CtaBand from '../components/CtaBand.astro';
import FolioShell from '../components/folios/FolioShell.astro';
import MandateExplorer from '../components/folios/MandateExplorer.astro';
import { exclusions } from '../data/site';

const preferredCharacteristics = [
  ['Repeat demand', 'Recurring, contracted or repeat customer demand.'],
  ['Defensible ties', 'Durable customer and supplier relationships.'],
  ['Clear earnings', 'Consistent, understandable financial performance.'],
  ['Transferable operations', 'Capable employees and operating processes that can transition.'],
  ['Sensible capital needs', 'Practical working-capital and capital-expenditure requirements.'],
  ['Room to continue', 'Credible opportunities for measured future growth.'],
] as const;
---

<BaseLayout
  title="What We Acquire | Hyperboards"
  description="See the financial profile, characteristics and industries of businesses Hyperboards may buy directly from their owners."
>
  <FolioShell
    eyebrow="What we acquire"
    index="01"
    title="The acquisition mandate."
    intro="Hyperboards buys established, profitable companies directly from their owners. The figures are guidelines—not an automatic decision or a commitment to transact."
  >
    <div slot="visual">
      <MandateExplorer />
    </div>
    <div slot="actions">
      <ButtonLink href="/contact">Discuss a potential sale</ButtonLink>
      <ButtonLink href="#quality-docket" variant="light">Review what matters</ButtonLink>
    </div>
  </FolioShell>

  <section class="quality-docket section" id="quality-docket">
    <div class="quality-docket__layout container-wide">
      <header class="quality-docket__header" data-reveal>
        <p class="eyebrow">Beyond the ranges</p>
        <h2>Quality we can understand. Strength we can preserve.</h2>
        <p>
          Financial fit starts the conversation. The durability of the company—and how well it can transition—determines whether it should continue.
        </p>
        <ButtonLink href="/our-approach" variant="secondary">How we evaluate a business</ButtonLink>
      </header>

      <ol class="quality-docket__entries" aria-label="Preferred business characteristics">
        {preferredCharacteristics.map(([title, body], index) => (
          <li data-reveal>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mandate-boundaries section section--navy">
    <div class="mandate-boundaries__layout container-wide">
      <div class="mandate-boundaries__copy" data-reveal>
        <p class="eyebrow">Current boundaries</p>
        <h2>A focused mandate allows a candid answer.</h2>
        <p>
          We concentrate our diligence where we have genuine acquisition interest. Sector inclusion never replaces business-specific underwriting.
        </p>
        <div class="mandate-boundaries__stamp" aria-label="Mandate qualification">
          <span>Every opportunity</span>
          <strong>Independently reviewed</strong>
        </div>
      </div>

      <div class="mandate-boundaries__exclusions" data-reveal>
        <p>Outside our present mandate</p>
        <ul aria-label="Currently excluded industries">
          {exclusions.map((item, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Sell directly to Hyperboards"
    title="Considering selling a business that fits?"
    body="Speak directly with Hyperboards as the prospective buyer. No formal sale process is required."
    label="Discuss a potential sale"
  />
</BaseLayout>

<style>
  .quality-docket {
    background-color: var(--color-paper);
    background-image: var(--texture-paper);
  }

  .quality-docket__layout,
  .mandate-boundaries__layout {
    display: grid;
    gap: var(--space-xl);
  }

  .quality-docket__header {
    align-self: start;
  }

  .quality-docket__header h2 {
    max-width: 12ch;
    margin-bottom: var(--space-md);
  }

  .quality-docket__header > p:not(.eyebrow) {
    max-width: 37rem;
    color: var(--color-slate);
  }

  .quality-docket__header .button {
    margin-top: var(--space-md);
  }

  .quality-docket__entries {
    padding: 0;
    border-block: 1px solid var(--color-border);
    margin: 0;
    list-style: none;
  }

  .quality-docket__entries li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
    transition: transform 220ms var(--ease-out);
  }

  .quality-docket__entries li:last-child {
    border-bottom: 0;
  }

  .quality-docket__entries li:hover {
    transform: translate3d(0.35rem, 0, 0);
  }

  .quality-docket__entries span,
  .mandate-boundaries__exclusions span {
    color: var(--color-brass-dark);
    font-family: var(--font-mono);
    font-size: 0.63rem;
  }

  .quality-docket__entries h3 {
    margin-bottom: 0.35rem;
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 720;
    letter-spacing: -0.025em;
  }

  .quality-docket__entries p {
    color: var(--color-slate);
  }

  .mandate-boundaries {
    position: relative;
    overflow: hidden;
  }

  .mandate-boundaries::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(251, 250, 246, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251, 250, 246, 0.035) 1px, transparent 1px);
    background-size: 5rem 5rem;
    content: '';
    mask-image: linear-gradient(90deg, transparent, #000);
    pointer-events: none;
  }

  .mandate-boundaries__layout {
    position: relative;
  }

  .mandate-boundaries h2 {
    max-width: 11ch;
  }

  .mandate-boundaries__copy > p:last-of-type {
    max-width: 38rem;
  }

  .mandate-boundaries__stamp {
    display: inline-grid;
    gap: 0.25rem;
    margin-top: var(--space-lg);
    padding: 1rem 1.2rem;
    border: 1px solid rgba(199, 168, 91, 0.6);
    color: var(--color-brass-light);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    transform: rotate(-1.5deg);
  }

  .mandate-boundaries__stamp strong {
    color: var(--color-white);
    font-weight: 500;
  }

  .mandate-boundaries__exclusions {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid rgba(199, 168, 91, 0.42);
    border-radius: var(--radius-lg);
    background: rgba(7, 20, 42, 0.48);
    box-shadow: var(--deboss-shadow);
  }

  .mandate-boundaries__exclusions > p {
    margin-bottom: var(--space-md);
    color: rgba(251, 250, 246, 0.55);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mandate-boundaries__exclusions ul {
    display: grid;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mandate-boundaries__exclusions li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-sm);
    padding-block: 0.72rem;
    border-top: 1px solid var(--color-border-dark);
    color: var(--color-white);
  }

  @media (min-width: 64rem) {
    .quality-docket__layout,
    .mandate-boundaries__layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(30rem, 1.15fr);
    }

    .quality-docket__header {
      position: sticky;
      top: 8rem;
    }

    .mandate-boundaries__exclusions ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quality-docket__entries li {
      transition: none;
    }
  }
</style>
