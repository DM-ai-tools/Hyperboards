---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import CtaBand from '../components/CtaBand.astro';
import FolioShell from '../components/folios/FolioShell.astro';
import RoleComparator from '../components/folios/RoleComparator.astro';
import { criteria } from '../data/site';

const charterClauses = [
  ['01', 'Direct', 'We engage as a prospective buyer—not as a broker marketing the business to someone else.'],
  ['02', 'Selective', 'We pursue opportunities that fit our mandate and can withstand disciplined review.'],
  ['03', 'Respectful', 'We recognize the people, relationships and operating knowledge behind the numbers.'],
  ['04', 'Adaptable', 'We consider structure and transition in the context of the owner and the company.'],
] as const;
---

<BaseLayout
  title="About Hyperboards | We Buy Established Businesses"
  description="Hyperboards is a family-office buyer that acquires established, profitable businesses directly from owners."
>
  <FolioShell
    eyebrow="About Hyperboards"
    index="H"
    title="We buy businesses. We do not broker them."
    intro="Hyperboards is a family-office buyer focused on acquiring established, profitable companies directly from their owners. The party evaluating the opportunity is the prospective buyer."
  >
    <div slot="visual">
      <RoleComparator />
    </div>
    <div slot="actions">
      <ButtonLink href="/contact">Speak with the buyer</ButtonLink>
      <ButtonLink href="#charter" variant="light">Read our charter</ButtonLink>
    </div>
  </FolioShell>

  <section class="charter section section--paper" id="charter">
    <div class="charter__layout container-wide">
      <header class="charter__heading" data-reveal>
        <p class="eyebrow">The buyer’s charter</p>
        <h2>Clear in role. Careful in judgment.</h2>
        <p>
          Our identity is grounded in how we approach owners and opportunities—not in unsupported claims about scale or transaction history.
        </p>
        <div class="charter__seal" aria-hidden="true"><span>H</span><small>Principal</small></div>
      </header>

      <ol class="charter__clauses">
        {charterClauses.map(([number, title, body]) => (
          <li data-reveal>
            <span>{number}</span>
            <div><h3>{title}</h3><p>{body}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mandate-stamp section section--navy">
    <div class="mandate-stamp__layout container-wide">
      <div data-reveal>
        <p class="eyebrow">Where we focus</p>
        <h2>A defined acquisition mandate.</h2>
        <p>
          We concentrate on established companies within a practical financial range and sectors where durable demand can support continued performance.
        </p>
        <ButtonLink href="/what-we-acquire" variant="light">Explore the full criteria</ButtonLink>
      </div>

      <dl class="mandate-stamp__document" data-reveal>
        <div class="mandate-stamp__title">
          <dt>Hyperboards</dt>
          <dd>Acquisition profile</dd>
        </div>
        {criteria.slice(0, 3).map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
        <div class="mandate-stamp__note">
          <dt class="sr-only">Mandate note</dt>
          <dd>Guidelines only. Every opportunity is evaluated on its own facts.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="relationship-note section section--compact">
    <div class="relationship-note__layout container-wide" data-reveal>
      <div>
        <p class="eyebrow">Investment relationships</p>
        <h2>Selective and intentionally secondary.</h2>
      </div>
      <div>
        <p>
          On selected acquisitions, Hyperboards may work alongside aligned investment partners. The owner relationship and a clear buyer process remain central.
        </p>
        <ButtonLink href="/investor-relationships" variant="quiet">For investment partners</ButtonLink>
      </div>
    </div>
  </section>

  <CtaBand
    title="Considering the future of your business?"
    body="Start with a private introduction and the broad facts that matter."
  />
</BaseLayout>

<style>
  .charter__layout,
  .mandate-stamp__layout,
  .relationship-note__layout {
    display: grid;
    gap: var(--space-xl);
  }

  .charter__heading {
    position: relative;
    align-self: start;
    min-height: 25rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid rgba(11, 27, 54, 0.14);
    background: rgba(251, 250, 246, 0.56);
    box-shadow: var(--paper-tile-shadow);
  }

  .charter__heading::before {
    position: absolute;
    inset: 0.65rem;
    border: 1px solid rgba(11, 27, 54, 0.09);
    content: '';
    pointer-events: none;
  }

  .charter__heading > * {
    position: relative;
    z-index: 1;
  }

  .charter__heading h2 {
    max-width: 10ch;
    font-size: var(--step-4);
  }

  .charter__heading > p:not(.eyebrow) {
    max-width: 35rem;
    margin-top: var(--space-md);
    color: var(--color-slate);
  }

  .charter__seal {
    position: absolute;
    right: clamp(1.5rem, 4vw, 3rem);
    bottom: clamp(1.5rem, 4vw, 3rem);
    display: grid;
    width: 5.4rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-brass-dark);
    border-radius: 50%;
    transform: rotate(-6deg);
  }

  .charter__seal span {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .charter__seal small {
    align-self: start;
    margin-top: -0.75rem;
    color: var(--color-forest);
    font-family: var(--font-mono);
    font-size: 0.45rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .charter__clauses {
    padding: 0;
    border-block: 1px solid var(--color-border);
    margin: 0;
    list-style: none;
  }

  .charter__clauses li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-md);
    padding: clamp(1.25rem, 3vw, 2.1rem) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .charter__clauses li:last-child {
    border-bottom: 0;
  }

  .charter__clauses > li > span {
    color: var(--color-brass-dark);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .charter__clauses h3 {
    margin-bottom: 0.45rem;
    font-family: var(--font-sans);
    font-size: var(--step-2);
    font-weight: 720;
    letter-spacing: -0.025em;
  }

  .charter__clauses p {
    max-width: 42rem;
    color: var(--color-slate);
  }

  .mandate-stamp__layout > div:first-child {
    align-self: center;
  }

  .mandate-stamp h2 {
    max-width: 11ch;
  }

  .mandate-stamp__layout > div:first-child > p:last-of-type {
    max-width: 39rem;
  }

  .mandate-stamp .button {
    margin-top: var(--space-lg);
  }

  .mandate-stamp__document {
    position: relative;
    padding: clamp(1.4rem, 4vw, 2.7rem);
    border: 1px solid rgba(199, 168, 91, 0.62);
    margin: 0;
    background-color: rgba(244, 239, 226, 0.97);
    background-image: var(--texture-paper);
    color: var(--color-midnight);
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.22);
    transform: rotate(1deg);
  }

  .mandate-stamp__document::before {
    position: absolute;
    inset: 0.55rem;
    border: 1px solid rgba(11, 27, 54, 0.1);
    content: '';
    pointer-events: none;
  }

  .mandate-stamp__document > div {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 5rem;
    flex-direction: column-reverse;
    justify-content: space-between;
    padding-block: 1rem;
    border-bottom: 1px solid rgba(11, 27, 54, 0.14);
  }

  .mandate-stamp__document dt {
    color: var(--color-slate);
    font-size: 0.72rem;
  }

  .mandate-stamp__document dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    letter-spacing: -0.04em;
  }

  .mandate-stamp__document .mandate-stamp__title {
    min-height: auto;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    color: var(--color-forest);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .mandate-stamp__document .mandate-stamp__title dd,
  .mandate-stamp__document .mandate-stamp__title dt {
    color: inherit;
    font: inherit;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .mandate-stamp__document .mandate-stamp__note {
    position: relative;
    z-index: 1;
    display: block;
    min-height: auto;
    padding: 0;
    border: 0;
    margin-top: var(--space-md);
  }

  .mandate-stamp__document .mandate-stamp__note dd {
    color: var(--color-slate);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0;
  }

  .relationship-note h2 {
    max-width: 14ch;
    margin: 0;
    font-size: var(--step-3);
  }

  .relationship-note__layout > div:last-child {
    max-width: 42rem;
  }

  .relationship-note .button {
    margin-top: var(--space-sm);
  }

  @media (min-width: 64rem) {
    .charter__layout,
    .mandate-stamp__layout,
    .relationship-note__layout {
      grid-template-columns: minmax(20rem, 0.85fr) minmax(32rem, 1.15fr);
    }

    .mandate-stamp__document {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 var(--space-md);
    }

    .mandate-stamp__document .mandate-stamp__title,
    .mandate-stamp__document .mandate-stamp__note {
      grid-column: 1 / -1;
    }
  }
</style>
