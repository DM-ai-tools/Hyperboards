---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  marker?: string;
}

const { eyebrow, title, intro, marker = 'H' } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__grid container-wide">
    <div class="page-hero__copy" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{intro}</p>
    </div>
    <div class="page-hero__marker" aria-hidden="true">
      <span>{marker}</span>
      <svg viewBox="0 0 260 310">
        <path d="M25 270V38h80v92h50V38h80v232h-80v-90h-50v90z" fill="none" stroke="currentColor" stroke-width="1" />
        <path d="M0 290h260M0 20h260M25 0v310M235 0v310" fill="none" stroke="currentColor" stroke-width="0.6" opacity=".38" />
      </svg>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-xl) var(--space-2xl);
    background-color: var(--color-midnight);
    background-image: var(--texture-leather);
    color: rgba(251, 250, 246, 0.75);
  }

  .page-hero::before {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(251, 250, 246, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(251, 250, 246, 0.035) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    content: '';
    mask-image: linear-gradient(to right, transparent, #000 70%);
  }

  .page-hero__grid {
    position: relative;
    display: grid;
    align-items: end;
    gap: var(--space-lg);
  }

  .page-hero h1 {
    max-width: 13ch;
    margin-bottom: var(--space-md);
    color: var(--color-white);
    font-size: var(--step-4);
  }

  .page-hero__copy > p:last-child {
    max-width: 43rem;
    font-size: var(--step-1);
  }

  .page-hero__marker {
    position: relative;
    padding: clamp(0.8rem, 2vw, 1.35rem);
    border: 1px solid rgba(199, 168, 91, 0.42);
    border-radius: var(--radius-md);
    background: rgba(7, 20, 42, 0.34);
    justify-self: end;
    color: rgba(199, 168, 91, 0.55);
    box-shadow: var(--deboss-shadow);
  }

  .page-hero__marker::after {
    position: absolute;
    inset: 0.42rem;
    border: 0;
    border-radius: calc(var(--radius-md) - 0.2rem);
    background: var(--stitch-frame-compact);
    box-shadow: var(--stitch-channel-shadow);
    content: '';
    opacity: 0.76;
    pointer-events: none;
  }

  .page-hero__marker svg {
    width: clamp(10rem, 24vw, 19rem);
  }

  .page-hero__marker span {
    position: absolute;
    top: 50%;
    left: 50%;
    color: var(--color-brass);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    transform: translate(-50%, -50%);
  }

  @media (min-width: 48rem) {
    .page-hero__grid {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 47.99rem) {
    .page-hero__marker {
      position: absolute;
      right: -2rem;
      bottom: -5rem;
      opacity: 0.35;
    }
  }
</style>
