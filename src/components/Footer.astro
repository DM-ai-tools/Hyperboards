---
import Logo from './Logo.astro';
import { primaryNav } from '../data/site';
---

<footer class="site-footer">
  <div class="site-footer__main container-wide">
    <div class="site-footer__statement">
      <Logo inverse />
      <p>We buy established businesses directly from their owners.</p>
    </div>

    <div class="site-footer__nav">
      <div>
        <p class="site-footer__label">Explore</p>
        <ul>
          {primaryNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="site-footer__label">More</p>
        <ul>
          <li><a href="/investor-relationships">Investor relationships</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="site-footer__legal container-wide">
    <p>© {new Date().getFullYear()} Hyperboards. All rights reserved.</p>
    <p>General information only. No offer, advice or binding commitment.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-xl);
    background-color: #07142a;
    background-image: var(--texture-leather);
    color: rgba(251, 250, 246, 0.7);
    box-shadow: inset 0 1px 0 rgba(232, 217, 167, 0.18);
  }

  .site-footer__main {
    display: grid;
    gap: var(--space-xl);
    position: relative;
    padding-bottom: var(--space-xl);
  }

  .site-footer__main::before {
    position: absolute;
    right: 0;
    bottom: 1rem;
    left: 0;
    height: 6px;
    background: url('/assets/saddle-stitch-horizontal.svg') left center / 36px 6px repeat-x;
    content: '';
    opacity: 0.38;
  }

  .site-footer__statement p {
    max-width: 30rem;
    margin-top: var(--space-lg);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.18;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .site-footer__label {
    color: var(--color-brass-light);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-footer ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-footer li + li {
    margin-top: 0.65rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-white);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.7rem 2rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--color-border-dark);
    font-size: 0.72rem;
  }

  .site-footer__legal p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .site-footer__main {
      grid-template-columns: minmax(0, 1.35fr) minmax(24rem, 0.65fr);
    }
  }
</style>
