---
interface Props {
  href?: string;
  inverse?: boolean;
}

const { href = '/', inverse = false } = Astro.props;
---

<a class:list={['logo', { 'logo--inverse': inverse }]} href={href} aria-label="Hyperboards home">
  <svg class="logo__mark" viewBox="0 0 42 42" role="img" aria-hidden="true">
    <rect x="1" y="1" width="40" height="40" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M10 9v24M32 9v24M10 21h22" fill="none" stroke="currentColor" stroke-width="3" />
    <path d="M17 9v7M25 26v7" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
  <span class="logo__wordmark">Hyperboards</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.72rem;
    color: var(--color-midnight);
    text-decoration: none;
  }

  .logo--inverse {
    color: var(--color-white);
  }

  .logo__mark {
    width: 2.05rem;
    height: 2.05rem;
    color: var(--color-brass);
  }

  .logo__wordmark {
    font-family: var(--font-sans);
    font-size: 1.07rem;
    font-weight: 720;
    letter-spacing: -0.025em;
  }
</style>
