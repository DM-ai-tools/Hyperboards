---
import { criteria } from '../data/site';
---

<div class="criteria-band">
  <div class="criteria-band__inner container-wide">
    <p class="criteria-band__label">Acquisition profile</p>
    <dl>
      {criteria.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</div>

<style>
  .criteria-band {
    padding-block: clamp(0.8rem, 1.5vw, 1.3rem);
    background-color: var(--color-paper);
    background-image: var(--texture-paper);
    border-bottom: 1px solid var(--color-border);
  }

  .criteria-band__inner {
    position: relative;
    padding: var(--space-lg);
    border: 1px solid rgba(11, 27, 54, 0.17);
    border-radius: var(--radius-md);
    background: rgba(251, 250, 246, 0.58);
    box-shadow: var(--paper-tile-shadow);
  }

  .criteria-band__inner::after {
    position: absolute;
    inset: 0.5rem;
    border: 1px solid rgba(39, 72, 61, 0.16);
    border-radius: calc(var(--radius-md) - 0.2rem);
    box-shadow:
      inset 0 1px 1px rgba(11, 27, 54, 0.13),
      0 1px 0 rgba(255, 255, 255, 0.72);
    content: '';
    pointer-events: none;
  }

  .criteria-band__inner > * {
    position: relative;
    z-index: 1;
  }

  .criteria-band__label {
    margin-bottom: var(--space-md);
    color: var(--color-forest);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .criteria-band dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
    margin: 0;
  }

  .criteria-band dl div {
    padding: var(--space-sm);
    border-left: 1px solid var(--color-border);
    background: linear-gradient(90deg, rgba(199, 168, 91, 0.07), transparent 72%);
  }

  .criteria-band dt {
    color: var(--color-slate);
    font-size: var(--step--1);
  }

  .criteria-band dd {
    margin: 0.25rem 0 0;
    color: var(--color-midnight);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.05;
  }

  @media (min-width: 56rem) {
    .criteria-band__inner {
      display: grid;
      grid-template-columns: 11rem 1fr;
      align-items: end;
      gap: var(--space-lg);
    }

    .criteria-band__label {
      margin-bottom: 0;
    }

    .criteria-band dl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
