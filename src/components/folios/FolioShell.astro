---
import FolioLabel from './FolioLabel.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  index?: string;
}

const { eyebrow, title, intro, index = 'HB' } = Astro.props;
---

<section class="folio-cover" data-folio-cover>
  <div class="folio-cover__case container-wide">
    <div class="folio-cover__copy">
      <FolioLabel index={index} label={eyebrow} note="Private acquisition folio" />
      <h1>{title}</h1>
      <p class="folio-cover__intro">{intro}</p>
      {Astro.slots.has('actions') && (
        <div class="folio-cover__actions">
          <slot name="actions" />
        </div>
      )}
    </div>

    <div class="folio-cover__visual">
      <slot name="visual" />
    </div>
  </div>
</section>

<style>
  .folio-cover {
    position: relative;
    overflow: hidden;
    padding: clamp(1.15rem, 2vw, 2rem);
    background-color: var(--color-midnight);
    background-image: var(--texture-leather);
    background-blend-mode: screen, normal, soft-light;
    color: rgba(251, 250, 246, 0.76);
  }

  .folio-cover::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(251, 250, 246, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251, 250, 246, 0.035) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    content: '';
    mask-image: linear-gradient(90deg, transparent 4%, #000 72%);
    pointer-events: none;
  }

  .folio-cover__case {
    position: relative;
    display: grid;
    min-height: clamp(38rem, 73vh, 54rem);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
    padding: clamp(2.6rem, 7vw, 6.8rem) clamp(1.2rem, 5vw, 5.5rem);
    border: 1px solid rgba(199, 168, 91, 0.5);
    border-radius: var(--radius-lg);
    background: rgba(7, 20, 42, 0.22);
    box-shadow:
      inset 0 0 0 1px rgba(251, 250, 246, 0.045),
      inset 0 1.4rem 3rem rgba(0, 0, 0, 0.13),
      0 1.8rem 4.5rem rgba(0, 0, 0, 0.13);
  }

  .folio-cover__case::after {
    position: absolute;
    inset: 0.68rem;
    border-radius: calc(var(--radius-lg) - 0.25rem);
    background: var(--stitch-frame-panel);
    box-shadow: var(--stitch-channel-shadow);
    content: '';
    opacity: 0.86;
    pointer-events: none;
  }

  .folio-cover__copy,
  .folio-cover__visual {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .folio-cover__copy {
    animation: folio-copy-enter 720ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .folio-cover h1 {
    max-width: 12ch;
    margin-block: clamp(1.5rem, 4vw, 3.5rem) var(--space-md);
    color: var(--color-white);
    font-size: clamp(3.15rem, 7vw, 7.2rem);
    letter-spacing: -0.055em;
    line-height: 0.91;
    text-wrap: balance;
  }

  .folio-cover__intro {
    max-width: 42rem;
    color: rgba(251, 250, 246, 0.72);
    font-size: var(--step-1);
    line-height: 1.62;
  }

  .folio-cover__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .folio-cover__visual {
    animation: folio-visual-enter 780ms cubic-bezier(0.16, 1, 0.3, 1) 100ms both;
  }

  @keyframes folio-copy-enter {
    from { opacity: 0; transform: translate3d(-1.5rem, 0.8rem, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  @keyframes folio-visual-enter {
    from { opacity: 0; transform: translate3d(1.5rem, 0.8rem, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  @media (min-width: 64rem) {
    .folio-cover__case {
      grid-template-columns: minmax(0, 0.92fr) minmax(28rem, 1.08fr);
    }
  }

  @media (max-width: 63.99rem) {
    .folio-cover__case {
      min-height: auto;
    }

    .folio-cover h1 {
      max-width: 13ch;
    }
  }

  @media (max-width: 34rem) {
    .folio-cover {
      padding: 0.6rem;
    }

    .folio-cover__case {
      padding: 3.8rem 1.25rem 2rem;
    }

    .folio-cover h1 {
      font-size: clamp(2.75rem, 14vw, 4.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .folio-cover__copy,
    .folio-cover__visual {
      animation: none;
    }
  }
</style>
