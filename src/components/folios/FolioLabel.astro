---
interface Props {
  index: string;
  label: string;
  note?: string;
}

const { index, label, note } = Astro.props;
---

<div class="folio-label">
  <span class="folio-label__index">{index}</span>
  <span class="folio-label__name">{label}</span>
  {note && <span class="folio-label__note">{note}</span>}
</div>

<style>
  .folio-label {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.85rem;
    align-items: center;
    color: var(--color-brass-light);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .folio-label__index {
    display: inline-grid;
    width: 2rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgba(199, 168, 91, 0.62);
    border-radius: 50%;
    background: rgba(7, 20, 42, 0.46);
    box-shadow: inset 0 0 0 0.2rem rgba(199, 168, 91, 0.07);
  }

  .folio-label__name {
    color: rgba(251, 250, 246, 0.82);
  }

  .folio-label__note {
    flex-basis: 100%;
    color: rgba(251, 250, 246, 0.46);
    letter-spacing: 0.08em;
  }
</style>
