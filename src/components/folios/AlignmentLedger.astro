---
const principles = [
  {
    key: 'selective',
    title: 'Selective relationships',
    summary: 'Alignment, not broad distribution',
    detail: 'We develop a limited set of relationships around a shared approach to private-company ownership. A general appetite for deals is not, by itself, a fit.',
  },
  {
    key: 'transaction',
    title: 'Transaction by transaction',
    summary: 'Each opportunity stands alone',
    detail: 'Participation, structure and suitability are considered separately for each acquisition. Prior discussion does not create an allocation or future commitment.',
  },
  {
    key: 'roles',
    title: 'Clear roles',
    summary: 'Documented before participation',
    detail: 'Economics, governance, responsibilities and decision rights must be understood and formally documented before any investment participation.',
  },
  {
    key: 'confidentiality',
    title: 'Seller confidentiality',
    summary: 'Information shared deliberately',
    detail: 'Seller information is shared only at an appropriate stage, with suitable protections and a defined reason for access. The owner relationship remains central.',
  },
] as const;
---

<div class="ledger" data-alignment-ledger data-active="selective">
  <div class="ledger__masthead">
    <span>Alignment record</span>
    <span>Private / non-circulating</span>
  </div>

  <div class="ledger__body">
    <div class="ledger__entries" role="tablist" aria-label="Investment relationship principles">
      {principles.map((principle, index) => (
        <div class="ledger__row" data-ledger-row style={`--entry:${index}`}>
          <span class="ledger__number">0{index + 1}</span>
          <button
            type="button"
            role="tab"
            id={`ledger-tab-${principle.key}`}
            aria-controls={`ledger-panel-${principle.key}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-folio-option
            data-value={principle.key}
          >
            <strong>{principle.title}</strong>
            <small>{principle.summary}</small>
          </button>
        </div>
      ))}
    </div>

    <div class="ledger__sheet">
      <span class="ledger__clip" aria-hidden="true"></span>
      {principles.map((principle, index) => (
        <section
          role="tabpanel"
          id={`ledger-panel-${principle.key}`}
          aria-labelledby={`ledger-tab-${principle.key}`}
          data-folio-panel
          data-value={principle.key}
          hidden={index !== 0}
        >
          <p>Working principle / 0{index + 1}</p>
          <h2>{principle.title}</h2>
          <p>{principle.detail}</p>
          <div class="ledger__notation"><span>Reviewed</span><strong>Principle before participation</strong></div>
        </section>
      ))}
    </div>
  </div>

  <footer>
    <span>Hyperboards</span>
    <p>Relationship context only. Not an offering or commitment.</p>
  </footer>
</div>

<script>
  import { initSingleSelect } from '../../scripts/folio-controls';

  document.querySelectorAll<HTMLElement>('[data-alignment-ledger]').forEach(initSingleSelect);
</script>

<style>
  .ledger {
    position: relative;
    max-width: 61rem;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid rgba(11, 27, 54, 0.16);
    background-color: #eee9df;
    background-image: var(--texture-paper);
    box-shadow:
      0 2rem 5rem rgba(5, 16, 34, 0.25),
      inset 0 0 0 1px rgba(255, 255, 255, 0.55);
    color: var(--color-midnight);
    transform: rotate(0.35deg);
  }

  .ledger::before {
    position: absolute;
    inset: 0.65rem;
    border: 1px solid rgba(11, 27, 54, 0.09);
    content: '';
    pointer-events: none;
  }

  .ledger__masthead,
  .ledger footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-slate);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .ledger__masthead {
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-midnight);
  }

  .ledger__body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(1.6rem, 4vw, 3.2rem);
  }

  .ledger__entries {
    min-width: 0;
  }

  .ledger__row {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    border-bottom: 1px solid rgba(11, 27, 54, 0.13);
    opacity: 0;
    transform: translateY(0.75rem);
    animation: ledger-entry 560ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--entry) * 85ms + 120ms) forwards;
  }

  .ledger__number {
    padding-top: 1.05rem;
    color: var(--color-brass-dark);
    font-family: var(--font-mono);
    font-size: 0.59rem;
  }

  .ledger__row button {
    position: relative;
    display: grid;
    width: 100%;
    min-height: 4.7rem;
    gap: 0.25rem;
    align-content: center;
    padding: 0.85rem 1.7rem 0.85rem 0;
    border: 0;
    background: transparent;
    color: var(--color-slate);
    cursor: pointer;
    text-align: left;
  }

  .ledger__row button::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 0.18rem;
    height: 1.7rem;
    background: var(--color-brass);
    content: '';
    opacity: 0;
    transform: translateY(-50%) scaleY(0.35);
    transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out);
  }

  .ledger__row button[aria-selected='true'] {
    color: var(--color-midnight);
  }

  .ledger__row button[aria-selected='true']::after {
    opacity: 1;
    transform: translateY(-50%) scaleY(1);
  }

  .ledger__row strong {
    font-family: var(--font-sans);
    font-size: 0.92rem;
  }

  .ledger__row small {
    color: var(--color-slate);
    font-size: 0.7rem;
  }

  .ledger__sheet {
    position: relative;
    min-height: 25rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid rgba(11, 27, 54, 0.16);
    background: rgba(251, 250, 246, 0.78);
    box-shadow: var(--paper-tile-shadow);
  }

  .ledger__clip {
    position: absolute;
    top: -0.5rem;
    right: 1.4rem;
    width: 1.8rem;
    height: 3.8rem;
    border: 2px solid #ae8d3f;
    border-radius: 1rem 1rem 0.5rem 0.5rem;
    box-shadow: inset 1px 0 rgba(255, 247, 190, 0.45), 1px 2px 4px rgba(36, 24, 2, 0.22);
    transform: rotate(7deg);
  }

  .ledger__sheet section > p:first-child {
    color: var(--color-brass-dark);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .ledger__sheet h2 {
    max-width: 10ch;
    margin-block: 2rem 1.1rem;
    font-size: clamp(2.4rem, 4vw, 4rem);
    line-height: 0.94;
  }

  .ledger__sheet section > p:nth-child(3) {
    color: var(--color-slate);
    line-height: 1.68;
  }

  .ledger__notation {
    position: absolute;
    right: clamp(1.5rem, 4vw, 3rem);
    bottom: clamp(1.5rem, 4vw, 3rem);
    left: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(11, 27, 54, 0.14);
    color: var(--color-slate);
    font-size: 0.62rem;
  }

  .ledger footer {
    align-items: end;
    padding-top: 1rem;
    border-top: 1px solid rgba(11, 27, 54, 0.16);
  }

  .ledger footer p {
    max-width: 23rem;
    margin: 0;
    text-align: right;
  }

  @keyframes ledger-entry {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 48rem) {
    .ledger__body {
      grid-template-columns: minmax(14rem, 0.72fr) minmax(19rem, 1.28fr);
    }
  }

  @media (max-width: 47.99rem) {
    .ledger {
      transform: none;
    }

    .ledger__entries {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ledger__row {
      grid-template-columns: 1.7rem 1fr;
    }

    .ledger__sheet {
      min-height: 24rem;
    }
  }

  @media (max-width: 33rem) {
    .ledger__entries {
      grid-template-columns: 1fr;
    }

    .ledger__sheet {
      min-height: 27rem;
    }

    .ledger__masthead span:last-child,
    .ledger footer span {
      display: none;
    }

    .ledger footer p {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger__row {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .ledger__row button::after {
      transition: none;
    }
  }
</style>
